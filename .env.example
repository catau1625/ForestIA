# ForestIA · variables de entorno (desarrollo local con venv-forestia)
# Copiar a .env y ajustar. NUNCA commitear el .env real.

SECRET_KEY=cambiar-en-produccion
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos: vacío → SQLite (desarrollo). Completar → PostgreSQL.
DB_NAME=
DB_USER=forestia
DB_PASSWORD=forestia
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Notificaciones (ver apps/notifications/dispatchers.py)
WHATSAPP_TOKEN=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
